# ============================================================================
#  ZTDF / OpenTDF learning lab - environment (EXAMPLE)
#
#  Copy to .env (gitignored), chmod 600, and replace every CHANGE_ME value
#  with a strong random value, for example:  openssl rand -hex 24
#
#  Read by the docker compose CLI only; never mounted into a container.
#  Container-visible secrets are passed as explicit environment: entries in
#  docker-compose.yml.
#
#  keycloak_data.yaml carries the SAME client secrets and user passwords in
#  cleartext, because `opentdf provision keycloak` reads that file directly and
#  does no variable substitution. Keep the two files in step.
#
#  FIRST-BOOT-ONLY: POSTGRES_*, KC_DB_*, KC_BOOTSTRAP_ADMIN_* and every
#  CLIENT_SECRET_* / *_PASSWORD are consumed once, while the databases are
#  empty. Editing them later rotates nothing; `provision keycloak` even exits 0
#  while leaving the old object in place. To make a change real:
#     docker compose down -v && docker compose up -d
#  which destroys both databases (realm/users AND policy).
# ============================================================================

# ---- public hostnames (must match the reverse proxy routes + network aliases)
TDF_PLATFORM_HOST=platform.lab.example
TDF_KEYCLOAK_HOST=keycloak.lab.example
# the browser console (static SPA + same-origin /api/ proxy to the share API)
TDF_WEB_HOST=tdf.lab.example

# ---- pinned image versions ---------------------------------------------------
# The lab ran platform v0.25.1. Check upstream release notes and current CVEs
# before choosing Keycloak / node tags; pin exact versions, not "latest".
TDF_PLATFORM_IMAGE=registry.opentdf.io/platform:v0.25.1
TDF_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:CHANGE_ME_PINNED_26.x_TAG
TDF_POSTGRES_IMAGE=postgres:15.19-alpine
TDF_NODE_IMAGE=node:24-alpine

# ---- uid the platform/provision containers run as ---------------------------
# The upstream image runs as uid 65532. Running as your own uid lets the
# mounted private keys and keycloak_data.yaml stay mode 0600 without a chown.
TDF_RUN_AS=1000:1000

# ---- postgres ----------------------------------------------------------------
POSTGRES_DB=opentdf
POSTGRES_USER=opentdf
POSTGRES_PASSWORD=CHANGE_ME
# separate role + database created by postgres-init/01-keycloak-db.sh
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CHANGE_ME
KC_DB_DATABASE=keycloak

# ---- keycloak bootstrap admin (master realm) --------------------------------
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# ---- OIDC client secrets (mirror keycloak_data.yaml) ------------------------
# platform-admin     service account -> realm role opentdf-admin (otdfctl policy admin)
# platform-sdk       service account -> realm role opentdf-standard
# entity-resolution  used BY the platform to query the Keycloak admin API
# authorization-svc  used BY the platform's authorization service
# platform-dpop      DPoP-bound variant, unused while dpop.enforce is false
CLIENT_SECRET_PLATFORM_ADMIN=CHANGE_ME
CLIENT_SECRET_PLATFORM_SDK=CHANGE_ME
CLIENT_SECRET_ERS=CHANGE_ME
CLIENT_SECRET_AUTHZ=CHANGE_ME
CLIENT_SECRET_DPOP=CHANGE_ME

# ---- demo users (mirror keycloak_data.yaml) ---------------------------------
# user-a: classification=secret -> entitled to .../attr/classification/value/secret
# user-b: classification=public -> NOT entitled to secret (the DENY case)
USER_A_PASSWORD=CHANGE_ME
USER_B_PASSWORD=CHANGE_ME
