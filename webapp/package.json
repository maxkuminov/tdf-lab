{
  "name": "tdf-lab-console",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Browser console for the ZTDF/OpenTDF learning lab",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:wrapper && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "verify:headless": "npm run build:wrapper && vite build --config vite.e2e.config.ts && node e2e/dist/e2e.mjs",
    "build:wrapper": "vite build --config vite.wrapper.config.ts && node scripts/build-wrapper-template.mjs"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@opentdf/sdk": "0.20.0",
    "oidc-client-ts": "3.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
