# =============================================================================
#  tdf-console: static host for the TDF Lab Console SPA
#  web/default.conf.template - an envsubst TEMPLATE, not a config file.
#
#  web/entrypoint.sh validates the TDF_* environment variables, renders this
#  file to /tmp/tdf-lab/default.conf (the only writable path in the image) and
#  web/nginx.conf includes it from there. Only the ${TDF_*} names listed in the
#  entrypoint are substituted; nginx's own $variables pass through untouched.
#  Every substituted value has been checked against a strict pattern first
#  (an origin is exactly https://host[:port]), so none can carry a quote, a
#  space, a semicolon or a newline into a directive or a CSP.
#
#  TLS, HSTS, X-Content-Type-Options, Referrer-Policy and the rate limit all
#  come from the reverse proxy (see the Traefik labels in docker-compose.yml).
#  This file deliberately does NOT repeat them - a headers middleware overwrites, so duplicating them
#  here only creates two places to be wrong.
#
#  The one header Traefik does not set is Content-Security-Policy, and this app
#  wants one: it holds a bearer token in memory and talks to two other origins,
#  so pinning connect-src is worth having.
#
#  !! nginx add_header does NOT accumulate across levels. A location block that
#  !! sets ANY add_header discards every add_header inherited from the server
#  !! block. Setting the CSP once at server level and a Cache-Control inside
#  !! `location = /index.html` therefore served the app's own HTML with NO CSP -
#  !! observed in the lab on 2026-08-27, and silent, because the header is
#  !! simply absent rather than wrong. Every location below repeats the policy
#  !! through the $csp variable for that reason. If you add a location with an
#  !! add_header, repeat it there too, and re-check with:
#  !!   curl -sI https://tdf.lab.example/ | grep -i content-security-policy
# =============================================================================

map $host $csp {
    default "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ${TDF_PLATFORM_URL} ${TDF_KEYCLOAK_URL}; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self' ${TDF_KEYCLOAK_URL}";
}

# -----------------------------------------------------------------------------
#  CSP for /sealed/ - the self-decrypting HTML wrappers (lab journal §10l).
#
#  A wrapper is ONE file that has to work from a USB stick with no network, so
#  it carries its whole runtime - the page logic and the OpenTDF SDK - in a
#  single inline <script>. This path, and only this path, permits an inline
#  script, and permits exactly ONE, by SHA-256.
#
#  The hash is computed by `npm run build:wrapper` inside the image build
#  (webapp/scripts/build-wrapper-template.mjs writes it next to the generated
#  page) and baked into the image; the entrypoint substitutes it here. The
#  runtime carries no hostname - each wrapper's metadata does - so the hash
#  depends on the build alone, never on the deployment.
#
#  The hash is stable for a given build. Everything file-specific (the sealed
#  .tdf, the filename) travels as base64 in a hidden input and is decoded at
#  runtime, so the script text is byte-identical in every wrapper a given build
#  produces. `npm run build:wrapper` prints the hash, and so does
#  `npm run verify:headless`.
#
#  There is no 'self' here any more and no 'strict-dynamic': a wrapper loads
#  NOTHING - no module, no chunk, no second file. The single hash is the entire
#  script policy, which is as tight as this can be made. (Until 2026-08-28 the
#  page fetched a /sealed/runtime.js and this needed 'strict-dynamic' 'self';
#  the device-grant rewrite removed that file, so the allowance went with it.)
#
#  This is defence in depth, not the primary control. The primary control is
#  that a hostile filename or attribute FQN never reaches the page's markup at
#  all (webapp/src/wrapper/html.ts). The hash is what makes a FAILURE of that
#  control non-exploitable ON THIS ORIGIN: an injected <script> would not match
#  and would not run.
#
#  !! If the wrapper runtime or template changes AT ALL, this hash must change
#  !! with it or every wrapper served from here silently loses its runtime. The
#  !! browser check compares this file AND the live header against a freshly
#  !! generated page, and fails if they have drifted.
# -----------------------------------------------------------------------------
map $host $csp_sealed {
    default "default-src 'none'; script-src '${TDF_SEALED_SCRIPT_HASH}'; style-src 'unsafe-inline'; img-src data:; connect-src ${TDF_PLATFORM_URL} ${TDF_KEYCLOAK_URL}; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'";
}

server {
    # Unprivileged port: the image runs as uid 101 and cannot bind below 1024.
    listen       8080;
    listen       [::]:8080;
    server_name  _;

    root         /usr/share/nginx/html;
    index        index.html;

    # Do not advertise the nginx version on error pages or in Server:.
    server_tokens off;

    add_header Content-Security-Policy $csp always;

    # Single-page app: any path the user lands on after an OIDC redirect must
    # return index.html so the app can pick it up. The OIDC callback comes back
    # to "/" with a ?code= query, which this already covers.
    location / {
        add_header Content-Security-Policy $csp always;
        try_files $uri $uri/ /index.html;
    }

    # Hashed filenames, so they can be cached hard.
    location /assets/ {
        add_header Content-Security-Policy $csp always;
        # One directive, not `expires 1y` as well: both emit Cache-Control and
        # the response then carries two of them.
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # index.html is NOT hashed - never cache it, or a redeploy keeps serving the
    # old bundle's asset names and the page 404s its own JavaScript.
    location = /index.html {
        add_header Content-Security-Policy $csp always;
        add_header Cache-Control "no-store" always;
    }

    # Runtime configuration for the SPA (platform + Keycloak URLs, client ids),
    # rendered by the entrypoint from validated env vars. Never cached: it is
    # what changes between deployments of the same image.
    location = /config.js {
        root /tmp/tdf-lab;
        default_type application/javascript;
        add_header Content-Security-Policy $csp always;
        add_header Cache-Control "no-store" always;
        try_files /config.js =404;
    }

    # The Database panel's sealed table, exported by dbdemo/dbdemo.py. Served
    # from an OPTIONAL mount (a ConfigMap on Kubernetes, ./webapp/public under
    # Compose) so a re-export needs no image rebuild; falls back to a copy
    # baked into the bundle, else 404 (the panel then says there is no table).
    # Public on purpose: every cell is ciphertext.
    location = /records.json {
        root /srv/tdf-lab/records;
        add_header Content-Security-Policy $csp always;
        add_header Cache-Control "no-cache" always;
        try_files /records.json @records_bundled;
    }
    location @records_bundled {
        add_header Content-Security-Policy $csp always;
        add_header Cache-Control "no-cache" always;
        try_files /records.json =404;
    }

    # ---------------------------------------------------------------------
    # Same-origin proxy to the share API.
    #
    # This is the ONLY way tdf-share-api is reachable. It has no Traefik
    # router, no published port and no CORS configuration, because from the
    # browser's point of view /api/ is simply this origin - no preflight is
    # ever generated and there is no cross-origin surface to get wrong. It
    # also means the CSP above needs no change: connect-src 'self' already
    # covers it.
    #
    # The trailing slash on proxy_pass strips the /api prefix, so the API
    # routes are /files, /healthz - not /api/files.
    # ---------------------------------------------------------------------
    # The API's /healthz is unauthenticated and leaks a total file count. It
    # exists for the container's own in-network healthcheck, which reaches the
    # container directly and never traverses this proxy. Block the public path
    # exactly, so "every /api/ endpoint a client can reach requires auth"
    # is literally true. `=` is an exact match, so /api/healthzzz still proxies
    # (and 404s at the API).
    location = /api/healthz {
        return 404;
    }

    location /api/ {
        # add_header does not inherit into a location that sets its own, and
        # this block sets none - so the server-level CSP applies unchanged.
        # Repeat it anyway if you ever add one here.
        proxy_pass http://${TDF_SHARE_API_UPSTREAM}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";

        # 25m, while the API caps a file at 20m: a 21MB upload must reach the
        # API so it can answer 413 with a message, rather than nginx cutting
        # the connection with its own bare error page.
        client_max_body_size 25m;
        # Stream the body to the API instead of spooling it to /tmp first: /tmp
        # is a small tmpfs/emptyDir, and a buffered 17 MB upload would fill it
        # before the API ever saw the request.
        proxy_request_buffering off;
        proxy_read_timeout 60s;
    }

    # ---------------------------------------------------------------------
    # Self-decrypting HTML wrappers an operator has placed here, so the lab's
    # own origin can serve one (lab journal §10l). A wrapper is entirely
    # self-contained - there is no companion runtime file any more - so this
    # location serves nothing but those pages. `vite build` empties dist/, so
    # anything dropped in here is a demonstration copy, not storage.
    # Served from an OPTIONAL mount at /srv/tdf-lab/sealed/ (read-only root FS:
    # nothing can be dropped into the image itself).
    location /sealed/ {
        root /srv/tdf-lab;
        add_header Content-Security-Policy $csp_sealed always;
        add_header Cache-Control "no-cache" always;
        add_header X-Content-Type-Options "nosniff" always;
        try_files $uri =404;
    }

    # The page declares an inline data-URI icon, so a real browser never asks
    # for this path - but crawlers and curl do, and the SPA fallback would
    # answer them with the whole index.html. 204 is cheaper and honest.
    location = /favicon.ico {
        access_log off;
        return 204;
    }

    # Container healthcheck target. Deliberately unlogged and unauthenticated;
    # it is only reachable from inside the isolated lab-net network.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
